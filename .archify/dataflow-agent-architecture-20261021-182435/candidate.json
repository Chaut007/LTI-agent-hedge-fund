  "cards": [
    {
      "dot": "cyan",
      "title": "One interface, two phases",
      "items": [
        "Every agent returns the same Signal: score -1 to 1, confidence, horizon_days, rationale, cost_usd",
        "Phase 0 agents are plain code at zero cost and get built first",
        "Phase 1 LLM agents implement the same interface, so adding them rearchitects nothing"
      ]
    },
    {
      "dot": "rose",
      "title": "An LLM never sizes a position",
      "items": [
        "LLM agents may only emit a Signal; they never decide share counts or dollar amounts",
        "Aggregator, Risk Manager and Optimizer are deterministic code: unit-testable and free to run",
        "The Risk Manager holds a veto over the aggregated view, not one vote among many"
      ]
    },
    {
      "dot": "amber",
      "title": "Point-in-time or nothing",
      "items": [
        "SEC EDGAR companyfacts carries filing dates, so the lake can answer what was knowable on a given date",
        "Without that, an LLM backtest before the model training cutoff is contaminated and looks falsely brilliant",
        "The Backtester replays the same agent code against the same asof-keyed lake"
      ]
    },
    {
      "dot": "emerald",
      "title": "The feedback loop is the point",
      "items": [
        "Every decision is stored with the inputs that produced it",
        "Agents are scored out-of-sample and the aggregator reweights them",
        "cost_usd travels with every Signal, so a paid agent has to earn its keep"
      ]
    }
  ]
