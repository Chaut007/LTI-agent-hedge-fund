  "cards": [
    {
      "dot": "cyan",
      "title": "Phase 0 is the baseline, not the fallback",
      "items": [
        "The Deterministic Core runs at zero cost: yfinance, SEC EDGAR, FRED, Alpaca paper, GitHub Actions cron",
        "The LLM layer is only worth paying for if it beats this core out-of-sample",
        "Both phases share one Agent interface, so Phase 1 plugs in without rearchitecting"
      ]
    },
    {
      "dot": "rose",
      "title": "Risk Manager holds a veto, not a vote",
      "items": [
        "MAX_POSITION_PCT 0.10, 8 to 15 positions, LEVERAGE 1.0, ALLOW_SHORT False",
        "MAX_DAILY_TURNOVER 0.20, MAX_ORDER_VS_ADV 0.05",
        "KILL_SWITCH_DD 0.15 flattens to cash and requires a manual restart"
      ]
    },
    {
      "dot": "amber",
      "title": "Why these clock times",
      "items": [
        "Ingest after the close keeps filing dates honest, which is what prevents lookahead bias",
        "Batch API costs 50% less and a daily rebalance does not need a synchronous answer",
        "Orders go at 10:00 ET, not the 09:30 open, where spreads are widest",
        "Positions are always held overnight, so no trade counts against the PDT limit under $25k"
      ]
    },
    {
      "dot": "slate",
      "title": "Paper is the default mode",
      "items": [
        "Live trading requires an explicit --live flag plus a typed confirmation",
        "Every decision is logged with the inputs that produced it",
        "Three months of paper trading before any real capital"
      ]
    }
  ]
