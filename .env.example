# Copy to .env and fill in. Nothing here is committed (.env is gitignored).

# REQUIRED for SEC EDGAR. The SEC fair-access policy requires a real contact
# string on every request to data.sec.gov; requests without one get blocked.
# Format: a project name plus an email you actually read.
SEC_USER_AGENT="hedge-fund-research you@example.com"

# OPTIONAL, only needed for `hf macro`. Free key, no card:
#   https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""

# Optional overrides
# HF_LAKE_DIR=data/lake
# HF_UNIVERSE_FILE=data/universe/members.csv
# SEC_RPS=8
